# Server Configuration
PORT=3000
# ACCESS_SECRET=your_secure_access_secret_here
# Master password for the /admin panel (server-owned AI config). If unset,
# /admin is open for single-operator localhost dev; production requires it.
# ADMIN_SECRET=your_admin_master_password_here
# TRUST_PROXY=1

# AI Provider Configuration
# Supported options: gemini, openai, claude, grok, ollama, custom
AI_PROVIDER=gemini

# Default model configurations
# Gemini: gemini-1.5-flash, gemini-2.5-flash
# OpenAI: gpt-4o-mini, gpt-4o
# Claude: claude-3-5-sonnet-20241022, claude-3-5-haiku-20241022
# xAI Grok: grok-3, grok-3-mini (strong at structured/JSON output)
# Ollama: llama3, mistral, gemma
AI_MODEL=gemini-1.5-flash

# API Credentials. AI config is server-owned: set keys here or in the /admin
# panel (admin-panel values take precedence). Players cannot supply keys.
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=

# Fallback tier: after one retry, transient provider errors fail over per-call
# to this backup model (also configurable in /admin).
# FALLBACK_AI_PROVIDER=openai
# FALLBACK_AI_MODEL=gpt-4o-mini
# FALLBACK_API_KEY=

# Optional voice narration uses OPENAI_API_KEY and defaults to gpt-4o-mini-tts.
# TTS_MODEL=gpt-4o-mini-tts
# TTS_VOICE=marin

# Optional scene/heroic image generation (also configurable in /admin; unset =
# image generation off). Providers: openai (hosted, key falls back to
# OPENAI_API_KEY), sdwebui (local Stable-Diffusion-WebUI-compatible endpoint —
# never receives an API key). In production the endpoint must be set here, not
# in /admin (SSRF posture, same as CUSTOM_ENDPOINT_URL).
# IMAGE_PROVIDER=sdwebui
# IMAGE_MODEL=
# IMAGE_API_KEY=
# IMAGE_ENDPOINT_URL=http://localhost:7860
# IMAGE_TIMEOUT_MS=240000

# Ollama local configuration
OLLAMA_URL=http://localhost:11434

# Custom OpenAI-compatible endpoint URL (optional, e.g. OpenRouter, LM Studio)
# CUSTOM_ENDPOINT_URL=https://openrouter.ai/api/v1/chat/completions

# Optional per-role AI routing (five roles: SETUP, INTERACTION, CONTINUITY,
# REFEREE, NARRATION). Prefer the /admin panel — its per-role settings take
# precedence over these. Unset values inherit the primary AI settings above.
# SETUP_AI_PROVIDER=claude
# SETUP_AI_MODEL=
# SETUP_API_KEY=
# NARRATION_AI_PROVIDER=openai
# NARRATION_AI_MODEL=
# NARRATION_API_KEY=
# INTERACTION_AI_PROVIDER=grok
# INTERACTION_AI_MODEL=grok-3
# INTERACTION_API_KEY=
# CONTINUITY_AI_PROVIDER=ollama
# CONTINUITY_AI_MODEL=qwen2.5
# CONTINUITY_OLLAMA_URL=http://localhost:11434
# REFEREE_AI_PROVIDER=claude
# REFEREE_AI_MODEL=claude-3-5-sonnet-20241022
# REFEREE_API_KEY=
