# Server Configuration
PORT=3000

# AI Provider Configuration
# Supported options: gemini, openai, claude, ollama, custom
AI_PROVIDER=gemini

# Default model configurations
# Gemini: gemini-1.5-flash, gemini-2.5-flash
# OpenAI: gpt-4o-mini, gpt-4o
# Claude: claude-3-5-sonnet-20241022, claude-3-5-haiku-20241022
# Ollama: llama3, mistral, gemma
AI_MODEL=gemini-1.5-flash

# API Credentials (If configured server-side. Otherwise can be inputted in UI)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Ollama local configuration
OLLAMA_URL=http://localhost:11434

# Custom OpenAI-compatible endpoint URL (optional, e.g. OpenRouter, LM Studio)
# CUSTOM_ENDPOINT_URL=https://openrouter.ai/api/v1/chat/completions
