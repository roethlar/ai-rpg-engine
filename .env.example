# Server Configuration
PORT=3000
# ACCESS_SECRET=your_secure_access_secret_here
# TRUST_PROXY=1

# AI Provider Configuration
# Supported options: gemini, openai, claude, grok, ollama, custom
AI_PROVIDER=gemini

# Default model configurations
# Gemini: gemini-1.5-flash, gemini-2.5-flash
# OpenAI: gpt-4o-mini, gpt-4o
# Claude: claude-3-5-sonnet-20241022, claude-3-5-haiku-20241022
# xAI Grok: grok-3, grok-3-mini (strong at structured/JSON output)
# Ollama: llama3, mistral, gemma
AI_MODEL=gemini-1.5-flash

# API Credentials (If configured server-side. Otherwise can be inputted in UI)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=

# Optional voice narration uses OPENAI_API_KEY and defaults to gpt-4o-mini-tts.
# TTS_MODEL=gpt-4o-mini-tts
# TTS_VOICE=marin

# Ollama local configuration
OLLAMA_URL=http://localhost:11434

# Custom OpenAI-compatible endpoint URL (optional, e.g. OpenRouter, LM Studio)
# CUSTOM_ENDPOINT_URL=https://openrouter.ai/api/v1/chat/completions

# Optional Council DM routing. Unset values inherit the primary AI settings above.
# INTERACTION_AI_PROVIDER=grok
# INTERACTION_AI_MODEL=grok-3
# INTERACTION_API_KEY=
# CONTINUITY_AI_PROVIDER=ollama
# CONTINUITY_AI_MODEL=qwen2.5
# CONTINUITY_OLLAMA_URL=http://localhost:11434
# REFEREE_AI_PROVIDER=claude
# REFEREE_AI_MODEL=claude-3-5-sonnet-20241022
# REFEREE_API_KEY=
